[Unit]
Description=nom-nom (food calorie scanner)
After=network.target

[Service]
User=root
ExecStart=/opt/nom-nom/nom-nom
WorkingDirectory=/opt/nom-nom

Environment=APP_NAME=nom-nom
Environment=DB_PATH=

Environment=PORT=8890
Environment=AUTH_URL=https://auth-center.sh-development.ru
Environment=AUTH_INTERNAL=http://localhost:8886
Environment=APP_URL=https://nom-nom.sh-development.ru
Environment=APP_TOKEN=
Environment=SECRET_KEY=
Environment=AI_PROXY_URL=https://auth-proxy.sh-development.ru/nom-nom-ai
Environment=AI_PROXY_SECRET=
Environment=SCAN_MODEL=claude-opus-4-8
Environment=FREE_SCANS=3

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
