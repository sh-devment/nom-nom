# nom-nom — environment. Copy to .env and fill in.

# Region: ru | com — picks sh-development.<region> links, incl. the menu
# (set by the deploy matrix in prod). Empty means ru.
REGION=ru

# auth-center (see CLAUDE.md)
AUTH_URL=https://auth-center.sh-development.ru
AUTH_INTERNAL=https://auth-center.sh-development.ru
APP_URL=http://localhost:8890
APP_TOKEN=
SECRET_KEY=dev-secret

# Name of this app. The database is named after it when DB_PATH is unset, so
# APP_NAME=foo gives foo.db. Defaults to nom-nom. Also sets the --version banner
# and the `start app=…` log line.
APP_NAME=nom-nom

# SQLite path — an explicit value always wins over the APP_NAME-derived name.
# Here it points at the /data named volume (dev-compose), NOT the bind mount:
# modernc sqlite locking fails on macOS virtiofs. In prod use an absolute disk
# path. Leave unset to get <APP_NAME>.db in the working directory instead.
DB_PATH=/data/nom-nom.db
PORT=8890

# AI scan — each region (GitHub environment) picks its own provider, model and
# key. Only "gemini" for now. The model is NOT hardcoded so you can A/B test
# without a rebuild.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_KEY=

# All AI calls go through a Cloudflare AI Gateway (Google rejects some of our
# server IPs by geolocation). Base URL up to the provider segment, no trailing
# slash; the token is the gateway's cf-aig-authorization token.
AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/google-ai-studio
AI_GATEWAY_TOKEN=

# lifetime free AI scans a NEW user starts with. Changing this affects only users
# who sign up afterwards — existing users keep whatever they have left.
FREE_SCANS=3
